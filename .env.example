AJI_APP_NAME=Assam Job Intelligence
AJI_APP_ENV=development
AJI_DEBUG=false
AJI_LOG_LEVEL=INFO
AJI_DATABASE_URL=postgresql+psycopg://assam_admin:assam_dev_password@localhost:5432/assam_job_intelligence
AJI_CONFIDENCE_STANDARD_THRESHOLD=80
AJI_CONFIDENCE_CRITICAL_THRESHOLD=90
AJI_CONFIDENCE_REVISION_THRESHOLD=85
AJI_REVIEW_WEB_REVIEWER_IDENTIFIER=local-review-ui
AJI_MASTER_PUBLISHER_BATCH_SIZE=100
AJI_VERIFICATION_BATCH_SIZE=100
AJI_HISTORY_LOOKBACK_MONTHS=12
AJI_MONITOR_RUNNING_STALE_MINUTES=60
AJI_MONITOR_SUCCESS_STALE_HOURS=26
AJI_MONITOR_TREND_RUN_LIMIT=20
AJI_MONITOR_NOTIFICATION_CHANNELS=LOG
# AJI_MONITOR_NOTIFICATION_FILE=D:\ASSAM_JOB_DATA\notifications\events.jsonl
AJI_PUBLIC_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
AJI_PUBLIC_FORWARDED_ALLOW_IPS=127.0.0.1
AJI_PUBLIC_RATE_LIMIT_REQUESTS=120
AJI_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
AJI_PUBLIC_CACHE_MAX_AGE_SECONDS=60
AJI_PUBLIC_MAX_REQUEST_TARGET_BYTES=4096

# Used by the development PostgreSQL container.
POSTGRES_DB=assam_job_intelligence
POSTGRES_USER=assam_admin
POSTGRES_PASSWORD=assam_dev_password
POSTGRES_PORT=5432
