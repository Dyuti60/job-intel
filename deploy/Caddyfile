{$AJI_PUBLIC_HOSTNAME} {
	encode zstd gzip

	log {
		output file /var/log/caddy/access.json {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	@public path /jobs /jobs/* /api/public/v1/* /static/* /healthz /readyz
	handle @public {
		reverse_proxy public-web:8000
	}

	handle {
		respond "Not Found" 404
	}
}
